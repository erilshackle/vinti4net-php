# Excluir diretórios não necessários no pacote Composer
/docs export-ignore
/tests export-ignore
/.github export-ignore
/.cache export-ignore
/examples export-ignore
/dist export-ignore

# Excluir arquivos extras
/.gitignore export-ignore
