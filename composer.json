{
    "name": "erilshk/vinti4net",
    "homepage": "https://erilshackle.github.io/vinti4net-php/",
    "description": "SDK PHP de integração com a RedeVinti4 (SISP, Cabo Verde) para pagamentos online completo e seguro. Compra 3DS, Pagamento de Serviço, Recargas, Reembolsos e Recibos",
    "keywords": [
        "vinti4net",
        "sisp",
        "vinti4",
        "sisp-php",
        "cabo verde",
        "vinti4pay",
        "pagamentos vinti4",
        "pagamento web cv",
        "sdk-payment"
    ],
    "readme": "README.md",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Erilshk\\Sisp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eril Shackle",
            "email": "erilandocarvalho@gmail.com",
            "role": "developer",
            "homepage": "https://github.com/erilshackle"
        }
    ],
    "scripts": {
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit --colors=always",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}