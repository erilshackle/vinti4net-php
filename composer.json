{
    "name": "erilshk/vinti4net",
    "homepage": "https://erilshackle.github.io/vinti4net-php/",
    "description": "SDK PHP de integração com a RedeVinti4 (SISP, Cabo Verde) para pagamentos online completo e seguro. Compra 3DS, Pagamento de Serviço, Recargas, Reembolsos e Recibos",
    "keywords": [
        "vinti4net",
        "sisp",
        "vinti4",
        "sisp-php",
        "cabo verde",
        "vinti4pay",
        "pagamentos vinti4",
        "pagamento web cv",
        "sdk-payment"
    ],
    "readme": "README.md",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Eril\\Sisp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eril\\Sisp\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eril Shackle",
            "email": "erilandocarvalho@gmail.com",
            "role": "developer",
            "homepage": "https://github.com/erilshackle"
        }
    ],
    "scripts": {
        "check": [
            "@validates",
            "@test"
        ],
        "validates": "composer validate --strict",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-clover coverage.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/erilshackle/vinti4net-php/issues",
        "source": "https://github.com/erilshackle/vinti4net-php"
    }
}
